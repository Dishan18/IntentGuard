# PayPal sandbox app credentials
# Developer Dashboard -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# PayPal webhook ID, from scripts/register_webhook.py (needs a public HTTPS URL for the gateway).
# Empty: the gateway refuses webhooks and relies on its poller alone.
PAYPAL_WEBHOOK_ID=
# How often the poller checks refunds whose outcome isn't final, in seconds
RECONCILE_INTERVAL_S=60

# LLM for the demo agents (free tier key: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the primary model is overloaded or out of free-tier quota (each model has its own quota)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite

# Hosted demo only (python -m intentguard.hosted, the Docker image): the owner console's key, 20+ characters.
# Locally, scripts/register_agents.py generates one instead.
INTENTGUARD_OWNER_KEY=
