    {
      "name": "3. Owner API",
      "description": "What the owner console uses. Needs the owner key (`ownerKey`); agent keys get 401 here.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{ownerKey}}",
            "type": "string"
          }
        ]
      },
      "item": [
