                "key": "mcp-session-id",
                "value": "{{mcpSession}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp"
              ]
            },
            "description": "Within the owner's rules ($50 auto limit, 1 refund per customer per 30 days), so it's forwarded to PayPal's MCP server and moves sandbox money. Send it again and the per-customer rule (or replay protection) blocks the second one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"tools/call\",\n  \"id\": 7,\n  \"params\": {\n    \"name\": \"create_refund\",\n    \"arguments\": {\n      \"capture_id\": \"{{benCaptureId}}\",\n      \"amount\": {\n        \"currency_code\": \"USD\",\n        \"value\": \"10.00\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sse = pm.response.text().split('\\n').find(l => l.startsWith('data: '));",
                  "const message = sse ? JSON.parse(sse.slice(6)) : pm.response.json();",
                  "const content = message.result && message.result.content && message.result.content[0];",
                  "let tool = null; try { tool = JSON.parse(content.text); } catch (e) { tool = content && content.text; }",
                  "pm.test('decided', () => pm.expect(['ALLOW', 'BLOCK']).to.include(tool.decision || 'ALLOW'));",
                  "if (tool.decision === 'BLOCK') console.log('Already refunded once: ' + tool.codes.join(', '));",
                  "else pm.test('PayPal refunded it', () => pm.expect(tool.status).to.eql('COMPLETED'));"
                ]
              }
            }
          ]
        }
