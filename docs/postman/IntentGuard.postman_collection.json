        {
          "name": "create_refund $10 (ALLOW: a real sandbox refund)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "X-IntentGuard-Customer",
                "value": "{{customer}}",
